{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2024-EXAMPLE-1",
              "defaultConfiguration": { "level": "error" },
              "properties": { "security-severity": "9.8" }
            },
            {
              "id": "CVE-2024-EXAMPLE-2",
              "defaultConfiguration": { "level": "warning" },
              "properties": { "security-severity": "5.3" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2024-EXAMPLE-1",
          "level": "error",
          "message": { "text": "requests 2.20.0: CRITICAL remote code execution via crafted URL. Fixed in 2.32.0." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "dockerized/USER_FASTAPI/requirements.txt" }, "region": { "startLine": 8 } } }
          ]
        },
        {
          "ruleId": "CVE-2024-EXAMPLE-2",
          "level": "warning",
          "message": { "text": "jinja2 3.1.2: MEDIUM information disclosure. Fixed in 3.1.4." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "dockerized/USER_FASTAPI/requirements.txt" }, "region": { "startLine": 5 } } }
          ]
        }
      ]
    }
  ]
}
