.git
.infracost
.log
.__pyc
.DStore

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file is usually committed, so don't ignore it:
# .terraform.lock.hcl

# Plan output files
*.tfplan
